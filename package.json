{
  "name": "@c9up/helix-plugin-ream",
  "version": "0.1.7",
  "description": "Helix plugin for Ream \u2014 boots a Ream app under test and injects a TestClient on the test context",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./runner": {
      "types": "./src/runTests.ts",
      "import": "./src/runTests.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@c9up/helix": "^0.2.3",
    "@c9up/ream": "^0.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@c9up/helix": "^0.2.3",
    "@c9up/ream": "^0.2.7",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "tsx": "^4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./runner": {
        "types": "./dist/runTests.d.ts",
        "import": "./dist/runTests.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/helix-plugin-ream.git"
  }
}
